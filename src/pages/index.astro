---
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">Technical &amp; personal blog</p>
    <h1>Findings from work and<br />personal projects.</h1>
    <p class="lede">
      I'm Gian, a research engineer working on LLMs and the systems around
      them. I write up what I learn building things, at work and on my own:
      training, inference, agents, and whatever the current problem happens to
      be. Mostly the parts that are hard to find written down clearly,
      including what the code looked like, what it cost, and what I'd do
      differently.
    </p>
    <div class="hero-track" aria-hidden="true"></div>
  </section>

  <section class="recent">
    <p class="section-label">Recent writing</p>
    {posts.length === 0 ? (
      <p class="lede">First post landing soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}/`}>
              <h3>{post.data.title}</h3>
              <PostMeta pubDate={post.data.pubDate} tags={post.data.tags} />
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
